rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { 
      return request.auth != null; 
    }
    
    function isEditor() {
      return isSignedIn() &&
        (request.auth.token.email == 'hugo.yuri.77@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'editor'));
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (request.auth.uid == userId || isEditor())
        && request.resource.data.keys().hasAll(['role', 'points', 'badges'])
        && (request.resource.data.role == 'collaborator' || request.resource.data.role == 'editor');
      allow update: if isSignedIn() && (
        isEditor() || 
        (request.auth.uid == userId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['points', 'badges', 'role', 'readArticles', 'answeredQuizzes', 'email', 'createdAt']))
      );
    }

    match /articles/{articleId} {
      allow read: if isSignedIn();
      allow create: if isEditor() && request.resource.data.keys().hasAll(['title', 'content', 'status']);
      allow update: if isEditor();
      allow delete: if isEditor();
    }

    match /benefits/{benefitId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isEditor();
    }

    match /error_logs/{logId} {
      allow create: if isSignedIn();
      allow read: if isEditor();
    }

    match /feedbacks/{feedbackId} {
      allow create: if isSignedIn();
      allow read: if isEditor();
    }
  }
}
